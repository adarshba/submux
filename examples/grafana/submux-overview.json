{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "submux",
    "llm-gateway"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Protocol",
        "multi": true,
        "name": "protocol",
        "options": [],
        "query": "label_values(submux_requests_total, protocol)",
        "refresh": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model_group",
        "options": [],
        "query": "label_values(submux_requests_total{protocol=~\"$protocol\"}, model_group)",
        "refresh": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Consumer",
        "multi": true,
        "name": "consumer",
        "options": [],
        "query": "label_values(submux_requests_total, consumer)",
        "refresh": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Account",
        "multi": true,
        "name": "account_id",
        "options": [],
        "query": "label_values(submux_account_quota_utilization, account_id)",
        "refresh": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
