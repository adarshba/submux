# submux environment variables
# Every value here can also live in the TOML config file at
#   $XDG_CONFIG_HOME/submux/config.toml   (auto-created on first run)
# Env vars override the file. Copy this to .env, fill in your values, then:
#   source .env && submux
# Never commit .env — it contains credentials.

# Override the config file path (default: $XDG_CONFIG_HOME/submux/config.toml).
# SUBMUX_CONFIG=/etc/submux/config.toml

# Listen address (default: 127.0.0.1:8080)
SUBMUX_BIND=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Inbound auth — optional
# When set, every proxy route requires `Authorization: Bearer <key>` or
# `x-api-key: <key>`. Leave unset for open mode (anyone on SUBMUX_BIND can use
# the proxy). Generate one with: submux config init --rotate-key --force
# ---------------------------------------------------------------------------
# SUBMUX_API_KEY=smx_live_...

# ---------------------------------------------------------------------------
# Anthropic (Claude Max) — required for /v1/messages and /v1/chat/completions
# How to get: claude.ai → DevTools (F12) → Network tab → send a message →
#   click any api.anthropic.com request → Headers → authorization: Bearer <token>
# ---------------------------------------------------------------------------
SUBMUX_ANTHROPIC_OAUTH_TOKEN=sk-ant-oat01-...
# Optional: enables automatic session refresh when the access token expires.
# Found in the same request headers or response headers as sk-ant-ort01-...
SUBMUX_ANTHROPIC_OAUTH_REFRESH_TOKEN=sk-ant-ort01-...
# Override upstream (default: https://api.anthropic.com)
# SUBMUX_ANTHROPIC_UPSTREAM=https://api.anthropic.com

# ---------------------------------------------------------------------------
# Codex / ChatGPT Plus — required for /codex/* routes
# How to get: chatgpt.com → DevTools (F12) → Network tab → send a message →
#   click any chatgpt.com/backend-api request → Headers → authorization: Bearer <token>
# ---------------------------------------------------------------------------
SUBMUX_OPENAI_ACCESS_TOKEN=eyJhbGciOi...
# Optional: exported browser cookie jar as JSON. Leave blank if unsure.
SUBMUX_OPENAI_COOKIES=
# Optional: device UUID. Auto-generated on first run if left blank.
SUBMUX_OPENAI_DEVICE_ID=
# Override upstream (default: https://chatgpt.com)
# SUBMUX_OPENAI_UPSTREAM=https://chatgpt.com

